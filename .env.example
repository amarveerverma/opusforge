# ClipForge Configuration

# Server
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage Paths
DATA_DIR=data
DATABASE_URL=sqlite:///data/database/clipforge.db

# Whisper Transcription Settings
# Options for WHISPER_MODEL: large-v3-turbo (recommended for RTX 4060), large-v3, medium, small, base
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
# Compute types: float16, int8_float16, int8
WHISPER_COMPUTE_TYPE=float16

# Diarization (Optional Hugging Face token for pyannote.audio)
HF_TOKEN=

# External AI (Disabled by default; set to true if you want cloud LLM hook/title suggestions)
ENABLE_EXTERNAL_AI=false
GEMINI_API_KEY=
OPENAI_API_KEY=
